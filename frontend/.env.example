# NextAuth
NEXTAUTH_SECRET="change-moi-en-production"
NEXTAUTH_URL="http://localhost:3000"

# Keycloak (authentification — voir keycloak/realm-export.json)
KEYCLOAK_CLIENT_ID="educi-frontend"
KEYCLOAK_CLIENT_SECRET=""
KEYCLOAK_ISSUER="http://localhost:8080/realms/educi"

# Gateway (appelé côté serveur par les routes API du frontend, depuis le
# conteneur Docker — utiliser le nom de service "gateway", pas "localhost")
GATEWAY_URL="http://gateway:8000"

# NOTE : DATABASE_URL, GROQ_API_KEY, OPENAI_API_KEY ne sont plus nécessaires
# ici — le frontend n'appelle plus Prisma ni Groq directement, il passe par
# le gateway (voir chat-service pour ces clés côté microservices).

