{
  "realm": "educi",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 28800,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "fr"],
  "defaultLocale": "fr",
  "smtpServer": {
    "host": "smtp-relay.brevo.com",
    "port": "587",
    "from": "zanezana39@gmail.com",
    "fromDisplayName": "EduCI",
    "auth": "true",
    "starttls": "true",
    "ssl": "false",
    "user": "b7a1fb001@smtp-brevo.com",
    "password": "${vault.smtppassword}"
  },
  "roles": {
    "realm": [
      { "name": "ROLE_STUDENT" },
      { "name": "ROLE_TEACHER" },
      { "name": "ROLE_ADMIN" }
    ]
  },
  "clients": [
    {
      "clientId": "educi-frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost/*",
        "http://localhost:8080/*",
        "http://167.86.116.14:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost",
        "http://167.86.116.14:3000",
        "+"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["web-origins", "profile", "roles", "email"],
      "protocolMappers": [
        {
          "name": "grade_level",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "grade_level",
            "claim.name": "grade_level",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "bac_series",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "bac_series",
            "claim.name": "bac_series",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-id-token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "educi-backend",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "educi-admin-service",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${vault.adminclientsecret}"
    }
  ],
  "users": [
    {
      "username": "service-account-educi-admin-service",
      "enabled": true,
      "serviceAccountClientId": "educi-admin-service",
      "clientRoles": {
        "realm-management": ["manage-users"]
      }
    },
    {
      "username": "admin.demo",
      "email": "admin@educi.local",
      "enabled": true,
      "firstName": "Admin",
      "lastName": "Demo",
      "credentials": [
        { "type": "password", "value": "admin123", "temporary": false }
      ],
      "realmRoles": ["ROLE_ADMIN"]
    },
    {
      "username": "eleve.demo",
      "email": "eleve@educi.local",
      "enabled": true,
      "firstName": "Élève",
      "lastName": "Demo",
      "credentials": [
        { "type": "password", "value": "eleve123", "temporary": false }
      ],
      "realmRoles": ["ROLE_STUDENT"],
      "attributes": {
        "grade_level": ["Terminale D"],
        "bac_series": ["D"]
      }
    }
  ]
}
