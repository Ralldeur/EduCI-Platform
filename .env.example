# Copier en .env et remplir avant `docker compose up -d`
GROQ_API_KEY=replace_with_your_groq_api_key

# Secret de chiffrement des sessions NextAuth (frontend) — obligatoire, sans
# quoi le frontend ne peut pas créer de session valide au login. Générer une
# valeur aléatoire, ex. `openssl rand -base64 32`.
NEXTAUTH_SECRET=replace_with_a_random_secret

# Secret du client OIDC "educi-frontend" (voir keycloak/realm-export.json).
# Ce client est PUBLIC (PKCE, pas de secret) — laisser vide sauf si la
# config Keycloak du client est changée en confidentiel.
KEYCLOAK_CLIENT_SECRET=

# Secret du client de service Keycloak "educi-admin-service" (API Admin,
# page /admin/users) — voir keycloak/realm-export.json et
# cahier-des-charges-admin.md.
KEYCLOAK_ADMIN_CLIENT_SECRET=replace_with_your_keycloak_admin_client_secret

# Mot de passe Postgres (partagé par postgres, keycloak, auth-service et
# chat-service — voir docker-compose.yml). Sans cette variable, un mot de
# passe faible par défaut ("educi_admin_pwd") est utilisé — suffisant en
# local, mais À CHANGER avant tout déploiement partagé/prod : cette valeur
# par défaut est committée en clair dans l'historique git, donc publique.
# Générer avec `openssl rand -base64 24`. Attention : changer cette variable
# ne suffit PAS sur une base déjà initialisée (Postgres/Keycloak ne relisent
# ce mot de passe qu'à la création du volume) — voir audit sécurité.
POSTGRES_PASSWORD=replace_with_a_strong_password

# Identifiants de la console admin Keycloak (realm "master"). Sans ces
# variables, "admin"/"admin" est utilisé par défaut — À CHANGER avant tout
# déploiement partagé/prod (même mise en garde que POSTGRES_PASSWORD
# ci-dessus concernant un volume déjà initialisé).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_a_strong_password
