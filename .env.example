# Copier en .env et remplir avant `docker compose up -d`
GROQ_API_KEY=replace_with_your_groq_api_key

# Secret du client de service Keycloak "educi-admin-service" (API Admin,
# page /admin/users) — voir keycloak/realm-export.json et
# cahier-des-charges-admin.md.
KEYCLOAK_ADMIN_CLIENT_SECRET=replace_with_your_keycloak_admin_client_secret
